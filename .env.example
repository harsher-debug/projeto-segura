# Supabase — Configurações do Projeto
# Pegue esses valores em: Supabase Dashboard > Project Settings > API

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua_anon_key_aqui

# A Vercel tambem pode usar os nomes abaixo, vindos do guia do Supabase.
# O projeto aceita ambos os padroes.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua_publishable_key_aqui

# Apenas necessária para rodar o script import-imoveis.mjs (NUNCA exponha
# essa chave no frontend ou em repositórios públicos)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# API publica BXP de catalogo de imoveis
# Exemplo: http://SEU-IP-EXTERNO:8010/api/v1/publico/imobiliaria/cli_segura
BXP_API_BASE_URL=http://<IP-EXTERNO>:8010/api/v1/publico/imobiliaria/cli_segura
